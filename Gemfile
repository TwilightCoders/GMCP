source 'https://rubygems.org'

gemspec

# him is not published to RubyGems yet. https (not git@) so a fresh clone on a
# machine with no SSH key configured can still `bundle install`.
#
# For local development against a sibling checkout, override without editing
# this file:
#   bundle config set --local local.him ../him
gem 'him', git: 'https://github.com/TwilightCoders/him.git', branch: 'main'
