#!/usr/bin/env ruby

# Authorize a Google account for GMCP from the command line.
#
#   bin/gmcp-auth <account>
#
# Opens the OAuth consent page in a browser and captures the redirect on a
# local callback server. Use this when the gmcp_authorize MCP tool isn't
# reachable (server down, tools not loaded in the current session).
#
# Google shut off the out-of-band (urn:ietf:wg:oauth:2.0:oob) flow in 2022, so
# there is no copy-the-code path any more — the loopback redirect is the only
# option for a desktop client, and it is what Auth.authorize_interactive!
# implements.

# Bundler only in a checkout; an installed gem resolves through RubyGems.
require 'bundler/setup' if File.exist?(File.expand_path('../Gemfile', __dir__))
require_relative '../lib/gmcp'

# Unbuffered so progress is visible when stdout is a pipe, not just a TTY.
$stdout.sync = true

# Generous by default: this waits on a human completing a browser consent
# screen, not on a machine. Override with GMCP_AUTH_TIMEOUT (seconds).
TIMEOUT = Integer(ENV.fetch('GMCP_AUTH_TIMEOUT', 900))

account = ARGV[0]
if account.nil? || account.empty?
  abort "Usage: #{File.basename($PROGRAM_NAME)} <account>\n" \
        "  e.g. #{File.basename($PROGRAM_NAME)} you@example.com"
end

unless File.exist?(GMCP::Auth.credentials_path)
  abort "credentials.json not found at #{GMCP::Auth.credentials_path}\n\n" \
        "1. https://console.cloud.google.com/ → APIs & Services → Credentials\n" \
        "2. Create an OAuth 2.0 Client ID (Desktop app)\n" \
        "3. Save the JSON to that path"
end

result = Queue.new
url = GMCP::Auth.authorize_interactive!(
  account: account,
  timeout: TIMEOUT,
  on_success: ->(_acct) { result << :authorized },
  on_failure: ->(_acct, error) { result << error }
)

puts "Authorizing #{account} — a browser window should have opened."
puts
puts "If it did not, open this manually:"
puts "  #{url}"
puts
puts 'Waiting for the callback…'

case (outcome = result.pop(timeout: TIMEOUT))
when nil       then abort "Timed out after #{TIMEOUT}s with no callback. Nothing was stored."
when Exception then abort "Authorization failed: #{outcome.class}: #{outcome.message}"
end

# Prove the stored token actually works rather than trusting the callback.
begin
  GMCP::Auth.access_token(account: account)
rescue StandardError => e
  abort "Callback completed but the stored token does not work: #{e.class}: #{e.message}"
end

puts "Authorized #{account}."
puts "Token stored at #{GMCP::Auth.token_path(account)}"
